# build assets (staged by scripts/stage-sif-assets.sh)
sif-stage/
image/
*.sif
# a dated copy of an image kept while its replacement is checked
*.sif.[0-9]*
# offline bundle (created by scripts/fetch-offline-bundle.sh)
offline-bundle/
pggl-offline-bundle-*.tar
pggl-offline-bundle-*.tar.sha256
pggl-offline-bundle-*.tar.part-*
tool-images/
.offline-build/
