# Self-contained CPU pangenome environment for the germline workflow
#
# DeepVariant 1.10.0 (CPU) + samtools/bcftools + vg + node + cwltool +
# the pangenome CWL workflow tree, so any host with singularity/apptainer
# can run the pipeline with NO setup (no PATH/.local installs, no cwltool).
#
# Reference data (JaSaPaGe graph + indexes + linear ref, ~54 GB) is NOT
# bundled; bind-mount it or pass host paths at runtime (see run-pangenome.sh).
#
# Build on a HOST (singularity is not available inside a container):
#
#   cd /home/tago/biohack/pggl-workflow
#   ./scripts/stage-sif-assets.sh   # stage sif-stage/ + image/ build assets
#   singularity build deepvariant-opencode-cpu-vg.sif sif-build.def
#
# Usage on any host (no configuration):
#
#   singularity exec deepvariant-opencode-cpu-vg.sif \
#     /opt/pangenome/run-pangenome.sh \
#     --cram $PWD/sample.cram \
#     --gbz $PWD/JaSaPaGe.gbz --dist $PWD/jasa.dist \
#     --min $PWD/jasa.min --zipcodes $PWD/jasa.zipcodes \
#     --ref_paths $PWD/jasa.ref_paths.txt \
#     --ref $PWD/jasa.chm13.fa --ref_path_prefix CHM13v2#0# \
#     --autosome_interval /opt/pangenome/interval_files/chm13_t2t/autosome.bed \
#     --PAR_interval      /opt/pangenome/interval_files/chm13_t2t/PAR.bed \
#     --chrX_interval     /opt/pangenome/interval_files/chm13_t2t/chrX.bed \
#     --chrY_interval     /opt/pangenome/interval_files/chm13_t2t/chrY.bed \
#     --prefix SAMPLE --outdir out/
#
# The CRAM is decoded back to FASTQ (with ref) and re-mapped onto the pangenome
# with vg giraffe, exactly like a FASTQ lane, so the graph + giraffe indexes are
# always required.
#
Bootstrap: localimage
From: image/deepvariant-opencode-cpu.sif

%files
    sif-stage/vg /usr/local/bin/vg
    sif-stage/node /usr/local/node-v20.18.0-linux-x64
    sif-stage/wheels /opt/cwltool-wheels
    sif-stage/biobambam2 /opt/biobambam2
    Workflows /opt/pangenome/Workflows
    Tools /opt/pangenome/Tools
    scripts /opt/pangenome/scripts
    tools /opt/pangenome/tools
    interval_files /opt/pangenome/interval_files

%post
    set -eux

    # --- staged tool binaries must be present ---
    test -s /usr/local/bin/vg
    test -s /usr/local/node-v20.18.0-linux-x64/bin/node
    test -n "$(ls /opt/cwltool-wheels)"

    # bamsormadup (biobambam2) for the markdup stage; private libs in
    # /opt/biobambam2/lib, exposed via the /usr/local/bin wrapper.
    test -x /opt/biobambam2/bin/bamsormadup
    test -n "$(ls -A /opt/biobambam2/lib)"
    ! LD_LIBRARY_PATH=/opt/biobambam2/lib ldd /opt/biobambam2/bin/bamsormadup | grep -q 'not found'

    # node v20.18.0 on PATH (via /usr/local/bin)
    ln -sf /usr/local/node-v20.18.0-linux-x64/bin/node /usr/local/bin/node
    ln -sf /usr/local/node-v20.18.0-linux-x64/bin/npm /usr/local/bin/npm
    ln -sf /usr/local/node-v20.18.0-linux-x64/bin/npx /usr/local/bin/npx
    ln -sf /usr/local/node-v20.18.0-linux-x64/bin/corepack /usr/local/bin/corepack
    node --version

    # cwltool, offline from the staged wheels (image python 3.10, no venv/PEP668)
    python3 -m pip install --no-index --find-links /opt/cwltool-wheels \
        cwltool==3.2.20260720092025

    # workflow tree present (relative ../Tools, ../scripts must resolve)
    test -f /opt/pangenome/Workflows/germline-pangenome-cpu.cwl
    test -f /opt/pangenome/Tools/bamsormadup-to-markdup-bam.cwl
    test -f /opt/pangenome/scripts/bamsormadup-to-markdup-bam.sh
    test -f /opt/pangenome/Tools/vg-call-sv.cwl
    test -f /opt/pangenome/scripts/vg-call-sv.sh
    test -f /opt/pangenome/interval_files/chm13_t2t/autosome.bed
    test -f /opt/pangenome/tools/filter_fastq.py

    # launcher: runs the bundled workflow with native tools, no container layer
    cat > /opt/pangenome/run-pangenome.sh <<'LAUNCHER'
#!/bin/bash
# Runs the bundled workflow with the tools inside this image (no container
# layer). cwltool only accepts its own options *before* the workflow path,
# while workflow inputs go after it, so the runner options are hoisted out of
# the command line here: --outdir, --parallel, --tmpdir-prefix, ... can be
# written anywhere, including at the end as the README does
# (`... --prefix SAMPLE --outdir out/`). Everything else is passed through to
# the workflow untouched; `--` forces the rest to be workflow inputs.
set -euo pipefail

WF=/opt/pangenome/Workflows/germline-pangenome-cpu.cwl
RUNNER=()
INPUTS=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --outdir|--tmpdir-prefix|--tmp-outdir-prefix|--cachedir|--log-dir|\
        --max-ram|--max-cores|--timeout|--singularity-cache)
            if [ "$#" -lt 2 ]; then
                echo "$(basename "$0"): $1 needs a value" >&2
                exit 2
            fi
            RUNNER+=( "$1" "$2" )
            shift 2
            ;;
        --outdir=*|--tmpdir-prefix=*|--tmp-outdir-prefix=*|--cachedir=*|\
        --log-dir=*|--max-ram=*|--max-cores=*|--timeout=*)
            RUNNER+=( "$1" )
            shift
            ;;
        -p|--parallel|--debug|--quiet|--verbose|--timestamps|--leave-tmpdir|\
        --rm-tmpdir|--js-console|--relax-path-checks|--strict|--non-strict|\
        --validate|--print-deps)
            RUNNER+=( "$1" )
            shift
            ;;
        --)
            shift
            INPUTS+=( "$@" )
            break
            ;;
        *)
            INPUTS+=( "$1" )
            shift
            ;;
    esac
done

exec cwltool --no-container ${RUNNER[@]+"${RUNNER[@]}"} "$WF" ${INPUTS[@]+"${INPUTS[@]}"}
LAUNCHER
    chmod +x /opt/pangenome/run-pangenome.sh

    # drop staged wheels (kept cwltool installed above)
    rm -rf /opt/cwltool-wheels

    cat > /usr/local/bin/bamsormadup <<'WRAP'
#!/bin/bash
export LD_LIBRARY_PATH=/opt/biobambam2/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
exec /opt/biobambam2/bin/bamsormadup "$@"
WRAP
    chmod +x /usr/local/bin/bamsormadup

    # sanity: every CLI must resolve
    command -v vg cwltool node run_deepvariant samtools bcftools bamsormadup
    vg version
    cwltool --version
    node --version
    /opt/pangenome/run-pangenome.sh --help >/dev/null 2>&1 || true

%environment
    export PATH=/usr/local/bin:/opt/deepvariant/bin:/opt/conda/envs/bio/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export TF_USE_LEGACY_KERAS=1

%runscript
    exec "$@"

%test
    command -v vg cwltool node run_deepvariant samtools bcftools bamsormadup
    test -x /opt/biobambam2/bin/bamsormadup
    ! LD_LIBRARY_PATH=/opt/biobambam2/lib ldd /opt/biobambam2/bin/bamsormadup | grep -q 'not found'
    vg version
    cwltool --version
    cwltool --validate --no-container \
        /opt/pangenome/Workflows/germline-pangenome-cpu.cwl
    test -x /opt/pangenome/run-pangenome.sh
    test -f /opt/pangenome/tools/filter_fastq.py
